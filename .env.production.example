# Copy to .env.production on the VPS and fill in real values.
# NEVER commit .env.production (already in .gitignore).

# Postgres superuser used by all 6 service databases (one Postgres instance,
# one database per service — same pattern as local dev).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# Shared secret every service sends as X-Service-Token when calling another
# service's internal endpoints, and checks on its own. One value for all 6 is
# fine (see ServiceOrUserAuthorizeAttribute) — generate with:
#   openssl rand -base64 32
SERVICE_AUTH_TOKEN=CHANGE_ME

# JWT signing key. MUST be the exact same value on all 6 services (Authentication
# issues the token, the other 5 validate it with this same key). Generate with:
#   openssl rand -base64 48
JWT_SECRET_KEY=CHANGE_ME

# Google Sign-In OAuth client id (public, not a secret — safe to reuse the value
# already in story-fe-prj/.env.example).
GOOGLE_CLIENT_ID=851399996463-dthrfrcl3ku6363kdh69nbeu57ja14c7.apps.googleusercontent.com

# Production frontend origin (Cloudflare Pages custom domain), used for
# Cors:AllowedOrigins on every service. No trailing slash.
# Actually unused if the gateway is same-origin as the frontend (Option A in
# gateway/wrangler.toml) — the browser never calls the .NET services directly
# in that setup, only the Worker does (server-to-server, no CORS involved).
# Kept as a fallback in case a service is ever called directly.
FRONTEND_ORIGIN=https://truyenmacanh3.com

# Elasticsearch (stories search index + service logs, see docker-compose.prod.yml).
# Internal-only, same docker network -- no auth (xpack.security.enabled=false),
# never expose port 9200 to the host or Cloudflare directly.
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_STORIES_INDEX=storyverse-stories
# Master switch for dual-write (Content indexes stories into ES on
# create/update/publish/delete). Keep false until the elasticsearch container
# is confirmed healthy.
ELASTICSEARCH_SEARCH_ENABLED=false
# Only takes effect once ELASTICSEARCH_SEARCH_ENABLED=true. Cuts the read path
# (GetStoriesQueryHandler) over to Elasticsearch -- flip this on only after
# the one-time backfill (POST /v1/stories/admin/reindex-search) has run.
ELASTICSEARCH_SEARCH_READ_ENABLED=false
# How often StorySearchIndexSyncBackgroundService polls Postgres for changed
# stories/chapters to push into Elasticsearch. Defaults to 60 if unset.
STORY_SEARCH_SYNC_POLL_SECONDS=60

# Facebook Page credentials for the fanpage-daily-post skill (not read by any
# .NET service — the skill reads this file over SSH and calls the Graph API
# directly). Leave blank until a real Page + long-lived Page Access Token
# exist.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
